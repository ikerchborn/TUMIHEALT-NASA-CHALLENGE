{
  "name": "tumi-healt",
  "version": "0.1.0",
  "private": true,
  "description": "TUMI-HEALT — Astronaut Health Monitoring Software (NASA Space Apps Challenge 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "qa:a11y": "playwright test tests/e2e/phase8-qa.spec.ts --grep \"axe accessibility\"",
    "qa:screenshots": "playwright test tests/e2e/phase8-qa.spec.ts --grep \"required viewport screenshots\"",
    "qa:lighthouse": "node scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "dexie": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "chrome-launcher": "^1.2.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "lighthouse": "^13.6.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
